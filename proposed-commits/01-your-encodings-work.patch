diff --git a/src/encoded_dsm.cpp b/src/encoded_dsm.cpp
new file mode 100644
index 0000000..42b277e
--- /dev/null
+++ b/src/encoded_dsm.cpp
@@ -0,0 +1,36 @@
+#include "encoded_dsm.h"
+
+#include "query.h"
+
+std::string scan_mode_name(ScanMode m) { return m == ScanMode::Value ? "value" : "vector"; }
+
+bool parse_scan_mode(const std::string& name, ScanMode& out) {
+    if (name == "value") out = ScanMode::Value;
+    else if (name == "vector") out = ScanMode::Vector;
+    else return false;
+    return true;
+}
+
+EncodedColumns::EncodedColumns(const Table& t, Encoding e) : encoding(e), rows(t.rows) {
+    std::vector<int64_t> values(t.rows);
+    columns.reserve(t.cols);
+    for (std::size_t c = 0; c < t.cols; ++c) {
+        for (std::size_t r = 0; r < t.rows; ++r) values[r] = t.at(r, c);
+        columns.push_back(encode_column(e, values));
+    }
+}
+
+EncodedDsmLayout::EncodedDsmLayout(std::shared_ptr<const EncodedColumns> data, ScanMode mode)
+    : data_(std::move(data)), mode_(mode) {}
+
+std::string EncodedDsmLayout::name() const {
+    return "DSM-" + encoding_name(data_->encoding) + "-" + scan_mode_name(mode_);
+}
+
+std::size_t EncodedDsmLayout::footprint_bytes() const {
+    std::size_t bytes = 0;
+    for (const auto& c : data_->columns) bytes += c->footprint_bytes();
+    return bytes;
+}
+
+void EncodedDsmLayout::run(Query& q) const { q.run(*this); }
diff --git a/src/encoded_dsm.h b/src/encoded_dsm.h
new file mode 100644
index 0000000..4a124ca
--- /dev/null
+++ b/src/encoded_dsm.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <memory>
+#include <vector>
+
+#include "encodings/encoded_column.h"
+#include "layout.h"
+#include "table.h"
+
+// How a query reads an encoded column.
+//   Value:  one ColumnCursor::next() call (virtual) per value.
+//   Vector: one EncodedColumn::decode() call (virtual) per kBatch values into a buffer,
+//           then a tight loop over the buffer.
+enum class ScanMode { Value, Vector };
+
+std::string scan_mode_name(ScanMode m);
+bool parse_scan_mode(const std::string& name, ScanMode& out);
+
+// All columns of a table in one encoding. Shared by the Value and Vector layouts so the
+// data is encoded (and held in memory) only once per encoding.
+struct EncodedColumns {
+    EncodedColumns(const Table& t, Encoding e);
+
+    Encoding encoding;
+    std::size_t rows;
+    std::vector<std::unique_ptr<EncodedColumn>> columns;
+};
+
+// DSM (one storage unit per column) with every column encoded, read in one scan mode.
+// Named DSM-<encoding>-<mode>, e.g. DSM-dict-vector.
+class EncodedDsmLayout : public Layout {
+public:
+    EncodedDsmLayout(std::shared_ptr<const EncodedColumns> data, ScanMode mode);
+
+    std::string name() const override;
+    std::size_t rows() const override { return data_->rows; }
+    std::size_t cols() const override { return data_->columns.size(); }
+    std::size_t footprint_bytes() const override;
+
+    void run(Query& q) const override;
+
+    Encoding encoding() const { return data_->encoding; }
+    ScanMode mode() const { return mode_; }
+    const EncodedColumn& column(std::size_t c) const { return *data_->columns[c]; }
+
+private:
+    std::shared_ptr<const EncodedColumns> data_;
+    ScanMode mode_;
+};
diff --git a/src/encodings/bitpack.cpp b/src/encodings/bitpack.cpp
new file mode 100644
index 0000000..4b2ca70
--- /dev/null
+++ b/src/encodings/bitpack.cpp
@@ -0,0 +1,63 @@
+// bitpack: one frame for the whole column. Stores v - min(column) in w bits, where w is
+// the width of max - min. Compresses well only if the whole column has a narrow range.
+#include <algorithm>
+
+#include "encodings/bits.h"
+#include "encodings/encoded_column.h"
+
+namespace {
+
+class BitpackCursor final : public ColumnCursor {
+public:
+    BitpackCursor(const uint64_t* words, unsigned w, uint64_t min) : words_(words), w_(w), min_(min) {}
+    int64_t next() override {
+        return static_cast<int64_t>(bits::extract(words_, w_, i_++) + min_);
+    }
+
+private:
+    const uint64_t* words_;
+    unsigned w_;
+    uint64_t min_;
+    std::size_t i_ = 0;
+};
+
+class BitpackColumn final : public EncodedColumn {
+public:
+    explicit BitpackColumn(const std::vector<int64_t>& values) : n_(values.size()) {
+        if (values.empty()) return;
+        auto [lo, hi] = std::minmax_element(values.begin(), values.end());
+        min_ = static_cast<uint64_t>(*lo);
+        w_ = bits::width_for(static_cast<uint64_t>(*hi) - min_);
+        std::vector<uint64_t> offsets(values.size());
+        for (std::size_t i = 0; i < values.size(); ++i)
+            offsets[i] = static_cast<uint64_t>(values[i]) - min_;
+        bits::pack(offsets.data(), offsets.size(), w_, words_);
+    }
+
+    std::size_t size() const override { return n_; }
+    std::size_t footprint_bytes() const override {
+        return words_.size() * sizeof(uint64_t) + sizeof(min_) + sizeof(w_);
+    }
+
+    void decode(std::size_t start, std::size_t n, int64_t* out) const override {
+        uint64_t* u = reinterpret_cast<uint64_t*>(out);
+        bits::unpack(words_.data() + start / bits::kGroup * w_, w_, bits::groups_for(n), u);
+        for (std::size_t i = 0; i < n; ++i) u[i] += min_;
+    }
+
+    std::unique_ptr<ColumnCursor> cursor() const override {
+        return std::make_unique<BitpackCursor>(words_.data(), w_, min_);
+    }
+
+private:
+    std::size_t n_;
+    uint64_t min_ = 0;
+    unsigned w_ = 0;
+    std::vector<uint64_t> words_;
+};
+
+}  // namespace
+
+std::unique_ptr<EncodedColumn> make_bitpack_column(const std::vector<int64_t>& values) {
+    return std::make_unique<BitpackColumn>(values);
+}
diff --git a/src/encodings/bits.cpp b/src/encodings/bits.cpp
new file mode 100644
index 0000000..8eeb6a9
--- /dev/null
+++ b/src/encodings/bits.cpp
@@ -0,0 +1,64 @@
+#include "encodings/bits.h"
+
+#include <array>
+#include <utility>
+
+namespace bits {
+
+void pack(const uint64_t* values, std::size_t n, unsigned w, std::vector<uint64_t>& out) {
+    const std::size_t base = out.size();
+    out.resize(base + words_for(n, w), 0);
+    if (w == 0) return;
+    uint64_t* dst = out.data() + base;
+    for (std::size_t i = 0; i < n; ++i) {
+        const std::size_t bit = i * w;
+        const std::size_t word = bit / 64;
+        const unsigned shift = bit % 64;
+        dst[word] |= values[i] << shift;
+        if (shift + w > 64) dst[word + 1] |= values[i] >> (64 - shift);
+    }
+}
+
+namespace {
+
+// One group of 64 values at compile-time width W. After unrolling, every word index,
+// shift and the "crosses a word" test are constants.
+template <unsigned W>
+inline void unpack_group(const uint64_t* in, uint64_t* out) {
+    if constexpr (W == 0) {
+        for (unsigned i = 0; i < kGroup; ++i) out[i] = 0;
+    } else {
+        constexpr uint64_t mask = W == 64 ? ~uint64_t{0} : (uint64_t{1} << W) - 1;
+#pragma GCC unroll 64
+        for (unsigned i = 0; i < kGroup; ++i) {
+            const unsigned bit = i * W;
+            const unsigned word = bit / 64;
+            const unsigned shift = bit % 64;
+            uint64_t v = in[word] >> shift;
+            if (shift + W > 64) v |= in[word + 1] << ((64 - shift) & 63);
+            out[i] = v & mask;
+        }
+    }
+}
+
+template <unsigned W>
+void unpack_groups(const uint64_t* in, std::size_t groups, uint64_t* out) {
+    for (std::size_t g = 0; g < groups; ++g) unpack_group<W>(in + g * W, out + g * kGroup);
+}
+
+using UnpackFn = void (*)(const uint64_t*, std::size_t, uint64_t*);
+
+template <std::size_t... W>
+constexpr std::array<UnpackFn, sizeof...(W)> make_table(std::index_sequence<W...>) {
+    return {&unpack_groups<static_cast<unsigned>(W)>...};
+}
+
+constexpr auto kUnpack = make_table(std::make_index_sequence<65>{});
+
+}  // namespace
+
+void unpack(const uint64_t* in, unsigned w, std::size_t groups, uint64_t* out) {
+    kUnpack[w](in, groups, out);
+}
+
+}  // namespace bits
diff --git a/src/encodings/bits.h b/src/encodings/bits.h
new file mode 100644
index 0000000..1a7b6b9
--- /dev/null
+++ b/src/encodings/bits.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Bit-packing of unsigned integers at a fixed width w (0..64 bits per value), LSB first.
+//
+// Values are packed in groups of 64: a group of width w is exactly w 64-bit words, so
+// every group starts on a word boundary and can be unpacked by a kernel specialised for
+// w (see unpack()). A packed run of n values is padded with zeros to a whole number of
+// groups.
+namespace bits {
+
+constexpr std::size_t kGroup = 64;
+
+// Bits needed to store every value in [0, max_value]; 0 when max_value == 0.
+inline unsigned width_for(uint64_t max_value) {
+    return max_value == 0 ? 0 : 64 - static_cast<unsigned>(__builtin_clzll(max_value));
+}
+
+inline std::size_t groups_for(std::size_t n) { return (n + kGroup - 1) / kGroup; }
+
+inline std::size_t words_for(std::size_t n, unsigned w) { return groups_for(n) * w; }
+
+// Appends values[0, n), each < 2^w, to out at width w.
+void pack(const uint64_t* values, std::size_t n, unsigned w, std::vector<uint64_t>& out);
+
+// Value i of a packed run of width w starting at `in` (value-at-a-time access).
+inline uint64_t extract(const uint64_t* in, unsigned w, std::size_t i) {
+    if (w == 0) return 0;
+    const std::size_t bit = i * w;
+    const std::size_t word = bit / 64;
+    const unsigned shift = bit % 64;
+    uint64_t v = in[word] >> shift;
+    // A value never crosses a group's last word, so in[word + 1] is in bounds here.
+    if (shift + w > 64) v |= in[word + 1] << (64 - shift);
+    return w == 64 ? v : v & ((uint64_t{1} << w) - 1);
+}
+
+// Unpacks `groups` whole groups (64 * groups values) of width w from `in` into out.
+// Dispatches once on w to a fully unrolled kernel with constant shifts and masks.
+void unpack(const uint64_t* in, unsigned w, std::size_t groups, uint64_t* out);
+
+// Zigzag maps signed deltas to unsigned so small negative values stay small.
+inline uint64_t zigzag(uint64_t d) { return (d << 1) ^ (0 - (d >> 63)); }
+inline uint64_t unzigzag(uint64_t z) { return (z >> 1) ^ (0 - (z & 1)); }
+
+}  // namespace bits
diff --git a/src/encodings/delta.cpp b/src/encodings/delta.cpp
new file mode 100644
index 0000000..1763ac1
--- /dev/null
+++ b/src/encodings/delta.cpp
@@ -0,0 +1,93 @@
+// delta: per block of kBatch values, the block's first value plus the difference of each
+// value from the previous one, zigzag-encoded and bit-packed at the block's width.
+// Compresses well when neighbouring values are close (e.g. sorted data). Decoding is a
+// running sum, so each value depends on the one before it.
+#include <algorithm>
+
+#include "encodings/bits.h"
+#include "encodings/encoded_column.h"
+
+namespace {
+
+struct Block {
+    uint64_t first;
+    std::size_t offset;  // first word of this block in words_
+    unsigned width;
+};
+
+class DeltaCursor final : public ColumnCursor {
+public:
+    DeltaCursor(const std::vector<Block>& blocks, const uint64_t* words)
+        : blocks_(blocks), words_(words) {}
+    int64_t next() override {
+        const Block& b = blocks_[i_ / kBatch];
+        const std::size_t j = i_ % kBatch;
+        if (j == 0) acc_ = b.first;  // the first delta of a block is always 0
+        acc_ += bits::unzigzag(bits::extract(words_ + b.offset, b.width, j));
+        ++i_;
+        return static_cast<int64_t>(acc_);
+    }
+
+private:
+    // i_ and acc_ are kept apart on purpose: when adjacent, GCC merges their stores into
+    // one 16-byte store, and the next call's 8-byte loads of them cannot be
+    // store-forwarded from it (Zen 3), costing ~25 cycles per value.
+    std::size_t i_ = 0;
+    const std::vector<Block>& blocks_;
+    const uint64_t* words_;
+    uint64_t acc_ = 0;
+};
+
+class DeltaColumn final : public EncodedColumn {
+public:
+    explicit DeltaColumn(const std::vector<int64_t>& values) : n_(values.size()) {
+        std::vector<uint64_t> deltas(kBatch);
+        for (std::size_t start = 0; start < n_; start += kBatch) {
+            const std::size_t n = std::min(kBatch, n_ - start);
+            deltas[0] = 0;
+            uint64_t widest = 0;
+            for (std::size_t i = 1; i < n; ++i) {
+                uint64_t d = static_cast<uint64_t>(values[start + i]) -
+                             static_cast<uint64_t>(values[start + i - 1]);
+                deltas[i] = bits::zigzag(d);
+                widest = std::max(widest, deltas[i]);
+            }
+            Block b{static_cast<uint64_t>(values[start]), words_.size(),
+                    bits::width_for(widest)};
+            bits::pack(deltas.data(), n, b.width, words_);
+            blocks_.push_back(b);
+        }
+    }
+
+    std::size_t size() const override { return n_; }
+    std::size_t footprint_bytes() const override {
+        // Per block: 8-byte first value, 4-byte word offset, 1-byte width.
+        return words_.size() * sizeof(uint64_t) + blocks_.size() * (8 + 4 + 1);
+    }
+
+    void decode(std::size_t start, std::size_t n, int64_t* out) const override {
+        const Block& b = blocks_[start / kBatch];
+        uint64_t* u = reinterpret_cast<uint64_t*>(out);
+        bits::unpack(words_.data() + b.offset, b.width, bits::groups_for(n), u);
+        uint64_t acc = b.first;
+        for (std::size_t i = 0; i < n; ++i) {
+            acc += bits::unzigzag(u[i]);
+            u[i] = acc;
+        }
+    }
+
+    std::unique_ptr<ColumnCursor> cursor() const override {
+        return std::make_unique<DeltaCursor>(blocks_, words_.data());
+    }
+
+private:
+    std::size_t n_;
+    std::vector<Block> blocks_;
+    std::vector<uint64_t> words_;
+};
+
+}  // namespace
+
+std::unique_ptr<EncodedColumn> make_delta_column(const std::vector<int64_t>& values) {
+    return std::make_unique<DeltaColumn>(values);
+}
diff --git a/src/encodings/dict.cpp b/src/encodings/dict.cpp
new file mode 100644
index 0000000..3b2de03
--- /dev/null
+++ b/src/encodings/dict.cpp
@@ -0,0 +1,63 @@
+// dict: a sorted array of the column's distinct values, plus one bit-packed code per row
+// (the value's index in that array). Compresses well when there are few distinct
+// values, regardless of how large or spread out the values themselves are.
+#include <algorithm>
+
+#include "encodings/bits.h"
+#include "encodings/encoded_column.h"
+
+namespace {
+
+class DictCursor final : public ColumnCursor {
+public:
+    DictCursor(const int64_t* dict, const uint64_t* words, unsigned w)
+        : dict_(dict), words_(words), w_(w) {}
+    int64_t next() override { return dict_[bits::extract(words_, w_, i_++)]; }
+
+private:
+    const int64_t* dict_;
+    const uint64_t* words_;
+    unsigned w_;
+    std::size_t i_ = 0;
+};
+
+class DictColumn final : public EncodedColumn {
+public:
+    explicit DictColumn(const std::vector<int64_t>& values) : n_(values.size()), dict_(values) {
+        std::sort(dict_.begin(), dict_.end());
+        dict_.erase(std::unique(dict_.begin(), dict_.end()), dict_.end());
+        w_ = dict_.empty() ? 0 : bits::width_for(dict_.size() - 1);
+        std::vector<uint64_t> codes(values.size());
+        for (std::size_t i = 0; i < values.size(); ++i)
+            codes[i] = std::lower_bound(dict_.begin(), dict_.end(), values[i]) - dict_.begin();
+        bits::pack(codes.data(), codes.size(), w_, words_);
+    }
+
+    std::size_t size() const override { return n_; }
+    std::size_t footprint_bytes() const override {
+        return dict_.size() * sizeof(int64_t) + words_.size() * sizeof(uint64_t) + sizeof(w_);
+    }
+
+    void decode(std::size_t start, std::size_t n, int64_t* out) const override {
+        // Unpack the codes into out, then replace each code with its value in place.
+        uint64_t* u = reinterpret_cast<uint64_t*>(out);
+        bits::unpack(words_.data() + start / bits::kGroup * w_, w_, bits::groups_for(n), u);
+        for (std::size_t i = 0; i < n; ++i) out[i] = dict_[u[i]];
+    }
+
+    std::unique_ptr<ColumnCursor> cursor() const override {
+        return std::make_unique<DictCursor>(dict_.data(), words_.data(), w_);
+    }
+
+private:
+    std::size_t n_;
+    std::vector<int64_t> dict_;
+    unsigned w_ = 0;
+    std::vector<uint64_t> words_;
+};
+
+}  // namespace
+
+std::unique_ptr<EncodedColumn> make_dict_column(const std::vector<int64_t>& values) {
+    return std::make_unique<DictColumn>(values);
+}
diff --git a/src/encodings/encoded_column.cpp b/src/encodings/encoded_column.cpp
new file mode 100644
index 0000000..df31686
--- /dev/null
+++ b/src/encodings/encoded_column.cpp
@@ -0,0 +1,54 @@
+#include "encodings/encoded_column.h"
+
+#include <stdexcept>
+
+namespace {
+
+struct EncodingInfo {
+    Encoding encoding;
+    const char* name;
+    std::unique_ptr<EncodedColumn> (*make)(const std::vector<int64_t>&);
+};
+
+// To add an encoding: write src/encodings/<name>.cpp and add one entry here.
+const EncodingInfo kEncodings[] = {
+    {Encoding::Plain, "plain", make_plain_column},
+    {Encoding::Bitpack, "bitpack", make_bitpack_column},
+    {Encoding::For, "for", make_for_column},
+    {Encoding::Dict, "dict", make_dict_column},
+    {Encoding::Rle, "rle", make_rle_column},
+    {Encoding::Delta, "delta", make_delta_column},
+};
+
+const EncodingInfo& info(Encoding e) {
+    for (const auto& i : kEncodings)
+        if (i.encoding == e) return i;
+    throw std::logic_error("unregistered encoding");
+}
+
+}  // namespace
+
+const std::vector<Encoding>& all_encodings() {
+    static const std::vector<Encoding> all = [] {
+        std::vector<Encoding> v;
+        for (const auto& i : kEncodings) v.push_back(i.encoding);
+        return v;
+    }();
+    return all;
+}
+
+std::string encoding_name(Encoding e) { return info(e).name; }
+
+bool parse_encoding(const std::string& name, Encoding& out) {
+    for (const auto& i : kEncodings) {
+        if (name == i.name) {
+            out = i.encoding;
+            return true;
+        }
+    }
+    return false;
+}
+
+std::unique_ptr<EncodedColumn> encode_column(Encoding e, const std::vector<int64_t>& values) {
+    return info(e).make(values);
+}
diff --git a/src/encodings/encoded_column.h b/src/encodings/encoded_column.h
new file mode 100644
index 0000000..285dfd1
--- /dev/null
+++ b/src/encodings/encoded_column.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+// Values per vectorized batch. Block-based encodings (FOR, delta) also use blocks of
+// kBatch values, and vectorized scans always start a batch at a multiple of kBatch, so a
+// batch is always exactly one block.
+constexpr std::size_t kBatch = 1024;
+
+// Value-at-a-time reader over one column: each next() decodes and returns one value.
+// It is a virtual call per value, like a tuple-at-a-time (Volcano) scan operator that
+// does not know the encoding at compile time.
+class ColumnCursor {
+public:
+    virtual ~ColumnCursor() = default;
+    // Must be called at most size() times.
+    virtual int64_t next() = 0;
+};
+
+// One encoded int64 column.
+class EncodedColumn {
+public:
+    virtual ~EncodedColumn() = default;
+
+    virtual std::size_t size() const = 0;
+
+    // Bytes the encoded data occupies (packed values, dictionaries, per-block headers).
+    virtual std::size_t footprint_bytes() const = 0;
+
+    // Vectorized: decodes values [start, start + n) into out with one virtual call.
+    // Requires start % kBatch == 0 and n <= kBatch. `out` must have room for kBatch
+    // values: decoders may write past n, up to the next multiple of 64.
+    virtual void decode(std::size_t start, std::size_t n, int64_t* out) const = 0;
+
+    // Value-at-a-time: a cursor positioned at row 0.
+    virtual std::unique_ptr<ColumnCursor> cursor() const = 0;
+};
+
+enum class Encoding { Plain, Bitpack, For, Dict, Rle, Delta };
+
+const std::vector<Encoding>& all_encodings();
+std::string encoding_name(Encoding e);
+// Returns false if `name` is not an encoding.
+bool parse_encoding(const std::string& name, Encoding& out);
+
+std::unique_ptr<EncodedColumn> encode_column(Encoding e, const std::vector<int64_t>& values);
+
+// One factory per encoding, each in src/encodings/<name>.cpp.
+std::unique_ptr<EncodedColumn> make_plain_column(const std::vector<int64_t>& values);
+std::unique_ptr<EncodedColumn> make_bitpack_column(const std::vector<int64_t>& values);
+std::unique_ptr<EncodedColumn> make_for_column(const std::vector<int64_t>& values);
+std::unique_ptr<EncodedColumn> make_dict_column(const std::vector<int64_t>& values);
+std::unique_ptr<EncodedColumn> make_rle_column(const std::vector<int64_t>& values);
+std::unique_ptr<EncodedColumn> make_delta_column(const std::vector<int64_t>& values);
diff --git a/src/encodings/for.cpp b/src/encodings/for.cpp
new file mode 100644
index 0000000..cbcdd09
--- /dev/null
+++ b/src/encodings/for.cpp
@@ -0,0 +1,78 @@
+// for (frame of reference): like bitpack, but with a separate frame per block of kBatch
+// values: each block stores its own min and bit width, so it adapts to local ranges
+// (e.g. sorted data, where each block covers a small slice of the value range).
+#include <algorithm>
+
+#include "encodings/bits.h"
+#include "encodings/encoded_column.h"
+
+namespace {
+
+struct Block {
+    uint64_t min;
+    std::size_t offset;  // first word of this block in words_
+    unsigned width;
+};
+
+class ForCursor final : public ColumnCursor {
+public:
+    ForCursor(const std::vector<Block>& blocks, const uint64_t* words)
+        : blocks_(blocks), words_(words) {}
+    int64_t next() override {
+        const Block& b = blocks_[i_ / kBatch];
+        uint64_t v = bits::extract(words_ + b.offset, b.width, i_ % kBatch) + b.min;
+        ++i_;
+        return static_cast<int64_t>(v);
+    }
+
+private:
+    const std::vector<Block>& blocks_;
+    const uint64_t* words_;
+    std::size_t i_ = 0;
+};
+
+class ForColumn final : public EncodedColumn {
+public:
+    explicit ForColumn(const std::vector<int64_t>& values) : n_(values.size()) {
+        std::vector<uint64_t> offsets(kBatch);
+        for (std::size_t start = 0; start < n_; start += kBatch) {
+            const std::size_t n = std::min(kBatch, n_ - start);
+            auto first = values.begin() + start;
+            auto [lo, hi] = std::minmax_element(first, first + n);
+            Block b{static_cast<uint64_t>(*lo), words_.size(), 0};
+            b.width = bits::width_for(static_cast<uint64_t>(*hi) - b.min);
+            for (std::size_t i = 0; i < n; ++i)
+                offsets[i] = static_cast<uint64_t>(values[start + i]) - b.min;
+            bits::pack(offsets.data(), n, b.width, words_);
+            blocks_.push_back(b);
+        }
+    }
+
+    std::size_t size() const override { return n_; }
+    std::size_t footprint_bytes() const override {
+        // Per block: 8-byte min, 4-byte word offset, 1-byte width.
+        return words_.size() * sizeof(uint64_t) + blocks_.size() * (8 + 4 + 1);
+    }
+
+    void decode(std::size_t start, std::size_t n, int64_t* out) const override {
+        const Block& b = blocks_[start / kBatch];
+        uint64_t* u = reinterpret_cast<uint64_t*>(out);
+        bits::unpack(words_.data() + b.offset, b.width, bits::groups_for(n), u);
+        for (std::size_t i = 0; i < n; ++i) u[i] += b.min;
+    }
+
+    std::unique_ptr<ColumnCursor> cursor() const override {
+        return std::make_unique<ForCursor>(blocks_, words_.data());
+    }
+
+private:
+    std::size_t n_;
+    std::vector<Block> blocks_;
+    std::vector<uint64_t> words_;
+};
+
+}  // namespace
+
+std::unique_ptr<EncodedColumn> make_for_column(const std::vector<int64_t>& values) {
+    return std::make_unique<ForColumn>(values);
+}
